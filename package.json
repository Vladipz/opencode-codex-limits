{
  "name": "opencode-codex-limits",
  "version": "1.1.0",
  "description": "OpenCode TUI plugin for displaying Codex usage limits",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "tsx --test --test-force-exit src/tui.test.mjs",
    "test:ui": "bun test --preload @opentui/solid/preload ./test/ui.test.tsx",
    "typecheck": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.19",
    "solid-js": "^1.9.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "opencode",
    "codex",
    "openai",
    "plugin"
  ],
  "devDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "@types/node": "^24.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
